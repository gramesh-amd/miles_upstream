# Binary-reward code RL at a 36864 context (32768 response cap): Dr. GRPO, truncated samples kept at
# reward 0, solved prompts retired. 2 trainer + 4 rollout nodes plus the sandbox node, so -N 7:
#
#   sbatch -A <account> -N 7 -t 24:00:00 -o ~/logs/%x-%j.out examples/instella_think/cluster/lux/run.sbatch \
#     examples/instella_think/cluster/lux/specs/code_binary_36k.env CODE_TRAIN=<train.jsonl> SAVE_TAG=<tag>
#
# VAR=VALUE arguments after this file override it (run.sbatch); add CHECK_ONLY=1 to run the preflights.
# An EXTRA_ARGS override replaces the one below, so repeat its sglang flags in it.
#
# DRGRPO_DIVISOR. The loss is summed over tokens and divided by this constant (drgrpo_reducer.py). For
# a new checkpoint or response cap, run the first 20 steps with DRGRPO_DIVISOR=32768 (the generation
# cap), then stop and resume with the mean of rollout/response_len/mean over steps 10-19. 16406 is
# that measurement for Instella-MoE-16B-A3B-DPO at this cap.
#
# Continuing from another run's checkpoint with its retired prompts: copy iter_<N>/ and
# rollout/retired_solved_<N>.pt into the new run's SAVE_DIR and write <N> to
# latest_checkpointed_iteration.txt there. Copy rollout/global_dataset_state_dict_<N>.pt too to
# continue the same pass over the same data; without it the data starts from the top of CODE_TRAIN.
# Completed groups carried over between steps and groups recycled into the data-source buffer live in
# memory only, so a resume regenerates them from fresh prompts.
#
# In-run eval is LiveCodeBench v3 at 4 samples (T=0.6, top_p 0.95) every 40 steps; EVAL_INTERVAL=100000
# turns it off (e.g. for an offline eval).
TRAIN_NODES=2
ROLLOUT_NODES=4
CONTEXT_LEN=36864
ROLLOUT_MAX_RESPONSE_LEN=32768
ROLLOUT_BATCH_SIZE=32
N_SAMPLES_PER_PROMPT=8
ROLLOUT_TEMPERATURE=1
DRGRPO=1
DRGRPO_DIVISOR=16406.0
PER_TOKEN_LOSS=0
OVERLONG_FILTER=0
ADAPTIVE_FILTER=0
RETIRE_SOLVED=1
ROUTER_LOG=1
CODE_REWARD_MODE=binary
CODE_REWARD_PASS_THRESHOLD=1.0
CODE_MAX_TESTS=128
CODE_EXEC_TIMEOUT=5
CODE_STRICT_GRADING=1
CODE_REQUIRE_THINK=1
MAX_TOKENS_PER_GPU=36864
ASYNC_MAX_CONCURRENT=1536
SGLANG_MAX_RUNNING_REQUESTS=1024
SGLANG_MEM_FRACTION=0.75
CODE_REWARD_CONCURRENCY=128
FP32_LM_HEAD_IMPL=fp32
RECOMPUTE_METHOD=block
RECOMPUTE_NUM_LAYERS=18
NUM_ROLLOUT=2000
SAVE_INTERVAL=20
EVAL_INTERVAL=40
CODE_BENCH_SETS=lcb_v3
CODE_BENCH_N=4
EXTRA_ARGS=--sglang-cuda-graph-max-bs-decode 128 --sglang-num-continuous-decode-steps 2
